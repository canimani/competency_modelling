definition
	CLUSTER[at0000] matches {    -- competency_base
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- competency_name
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- comeptency_description
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0004] occurrences matches {0..1} matches {    -- comeptency_level
				value matches {
					DV_CODED_TEXT matches {*}
				}
			}
			ELEMENT[at0005] occurrences matches {0..1} matches {    -- date_assessed
				value matches {
					DV_DATE_TIME matches {*}
				}
			}
			ELEMENT[at0006] occurrences matches {0..1} matches {    -- status
				value matches {
					DV_CODED_TEXT matches {*}
				}
			}
			allow_archetype CLUSTER[at0007] occurrences matches {0..1} matches {    -- competencyholder
				include
					archetype_id/value matches {/openEHR-EHR-CLUSTER\.clinical_non_sfia_competency\.v0|openEHR-EHR-CLUSTER\.other_non_sfia_competency\.v0|openEHR-EHR-CLUSTER\.sfia_competency-sfia_dh_competency\.v0|openEHR-EHR-CLUSTER\.sfia_competency-sfia_ict_competency\.v0/}
			}
		}
	}

