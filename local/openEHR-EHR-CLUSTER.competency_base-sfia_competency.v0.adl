definition
	CLUSTER[at0000.1] matches {    -- competency_base
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- competency_name
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- competency_description
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- competency_level
				value matches {
					DV_CODED_TEXT matches {*}
				}
			}
			ELEMENT[at0004] occurrences matches {0..1} matches {    -- date_asssesed
				value matches {
					DV_DATE_TIME matches {*}
				}
			}
			ELEMENT[at0005] occurrences matches {0..1} matches {    -- status
				value matches {
					DV_CODED_TEXT matches {*}
				}
			}
			ELEMENT[at0.1] occurrences matches {0..1} matches {    -- sfia_code
				value matches {
					DV_IDENTIFIER matches {*}
				}
			}
			ELEMENT[at0.4] occurrences matches {0..1} matches {    -- dh_domain
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0.5] occurrences matches {0..1} matches {    -- current_level
				value matches {
					DV_ORDINAL matches {*}
				}
			}
			ELEMENT[at0.6] occurrences matches {0..1} matches {    -- target_level
				value matches {
					DV_ORDINAL matches {*}
				}
			}
			ELEMENT[at0.7] occurrences matches {0..1} matches {    -- capability_tier
				value matches {
					DV_ORDINAL matches {*}
				}
			}
		}
	}

