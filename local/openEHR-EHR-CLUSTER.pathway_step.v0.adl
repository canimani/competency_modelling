definition
	CLUSTER[at0000] matches {    -- pathway_step
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- step_order
				value matches {
					DV_COUNT matches {*}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- step_label
				value matches {
					DV_TEXT matches {*}
				}
			}
			allow_archetype CLUSTER[at0003] occurrences matches {0..*} matches {    -- role_definition
				include
					archetype_id/value matches {/openEHR-EHR-CLUSTER\.role_definition\.v0/}
			}
			allow_archetype CLUSTER[at0004] occurrences matches {0..*} matches {    -- entry_rule
				include
					archetype_id/value matches {/openEHR-EHR-CLUSTER\.step_entry_rule\.v0/}
			}
			allow_archetype CLUSTER[at0005] occurrences matches {0..*} matches {    -- competency_deltas
				include
					archetype_id/value matches {/openEHR-EHR-CLUSTER\.competency_delta\.v0/}
			}
			ELEMENT[at0006] occurrences matches {0..1} matches {    -- typical_duration_month
				value matches {
					DV_COUNT matches {*}
				}
			}
		}
	}

