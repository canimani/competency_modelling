definition
	CLUSTER[at0000] matches {    -- transition_gate
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- min_time_in_current_role_months
				value matches {
					DV_COUNT matches {*}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- min_time_at_current_level_months
				value matches {
					DV_COUNT matches {*}
				}
			}
			ELEMENT[at0006] occurrences matches {0..1} matches {    -- requires_line_manager_approval
				value matches {
					DV_BOOLEAN matches {*}
				}
			}
			ELEMENT[at0007] occurrences matches {0..1} matches {    -- requires_panel_review
				value matches {
					DV_BOOLEAN matches {*}
				}
			}
			ELEMENT[at0008] occurrences matches {0..1} matches {    -- requires_clinical_approval
				value matches {
					DV_BOOLEAN matches {*}
				}
			}
			ELEMENT[at0013] matches {    -- gate_rationale
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0009] occurrences matches {0..1} matches {    -- required_overall_assessment
				value matches {
					DV_CODED_TEXT matches {*}
				}
				name matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0010,    -- met
							at0011]    -- partially_met
						}
					}
				}
			}
			ELEMENT[at0003] occurrences matches {0..*} matches {    -- required_sfia_codes
				value matches {
					DV_IDENTIFIER matches {*}
				}
			}
			ELEMENT[at0004] occurrences matches {0..1} matches {    -- required_min_level
				value matches {
					DV_ORDINAL matches {*}
				}
			}
			ELEMENT[at0005] occurrences matches {0..1} matches {    -- required_assessment_score
				value matches {
					DV_PROPORTION matches {*}
				}
			}
		}
	}

