definition
	CLUSTER[at0000] matches {    -- Ecosystem
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- name
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {*}    -- identifier
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- ecosystem_maturity
				value matches {
					DV_COUNT matches {*}
				}
			}
			ELEMENT[at0004] occurrences matches {0..1} matches {    -- country
				value matches {
					DV_TEXT matches {*}
				}
			}
		}
	}

