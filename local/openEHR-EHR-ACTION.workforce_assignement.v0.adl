definition
	ACTION[at0000] matches {    -- workforce_assignement
		description matches {
			ITEM_TREE[at0001] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] matches {    -- assignment_id
						value matches {
							DV_IDENTIFIER matches {*}
						}
					}
					ELEMENT[at0003] matches {    -- person_ehr_ref
						value matches {
							DV_EHR_URI matches {*}
						}
					}
					ELEMENT[at0004] matches {    -- organisation_ref
						value matches {
							DV_IDENTIFIER matches {*}
						}
					}
					ELEMENT[at0006] occurrences matches {0..1} matches {    -- organisation_group_ref
						value matches {
							DV_IDENTIFIER matches {*}
						}
					}
					ELEMENT[at0007] occurrences matches {0..1} matches {    -- role_profile_ref
						value matches {
							DV_IDENTIFIER matches {*}
						}
					}
					ELEMENT[at0015] occurrences matches {0..1} matches {    -- person_competency_record_ref
						value matches {
							DV_URI matches {*}
							DV_EHR_URI matches {*}
						}
					}
					ELEMENT[at0008] occurrences matches {0..1} matches {    -- universal_role_ref
						value matches {
							DV_IDENTIFIER matches {*}
						}
					}
					ELEMENT[at0009] occurrences matches {0..1} matches {    -- ecosystem_role_ref
						value matches {
							DV_IDENTIFIER matches {*}
						}
					}
					ELEMENT[at0010] matches {    -- assignment_start
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					ELEMENT[at0012] occurrences matches {0..1} matches {    -- assignement_end
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					ELEMENT[at0016] occurrences matches {0..1} matches {    -- ISAM_status
						value matches {
							DV_CODED_TEXT matches {*}
						}
						name matches {
							DV_CODED_TEXT matches {*}
						}
					}
					ELEMENT[at0013] occurrences matches {0..1} matches {    -- destination_organisation_ref
						value matches {
							DV_EHR_URI matches {*}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0005] matches {*}    -- Item tree
		}
		other_participations cardinality matches {0..*; unordered} matches {
			PARTICIPATION[at0014] occurrences matches {0..*} matches {*}    -- other_partciaptions
		}
	}

