definition
	CLUSTER[at0000] matches {    -- competency_group_gate
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {1..*} matches {    -- required_groups
				value matches {
					DV_CODED_TEXT matches {*}
				}
				name matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0002,    -- SFIA_ICT
							at0003,    -- SFIA_DH
							at0004,    -- Clinical_Non_SFIA
							at0005]    -- Other_Non_SFIA
						}
					}
				}
			}
			ELEMENT[at0006] occurrences matches {0..*} matches {    -- prohibited_groups
				value matches {
					DV_CODED_TEXT matches {*}
				}
				name matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0007,    -- SFIA_ICT
							at0008,    -- SFIA_DH
							at0009,    -- Clinical_Non_SFIA
							at0010]    -- Other_Non_SFIA
						}
					}
				}
			}
			ELEMENT[at0011] occurrences matches {0..1} matches {    -- min_competencies_per_group
				value matches {
					DV_COUNT matches {*}
				}
			}
			ELEMENT[at0012] occurrences matches {0..1} matches {    -- rational
				value matches {
					DV_TEXT matches {*}
				}
			}
		}
	}

