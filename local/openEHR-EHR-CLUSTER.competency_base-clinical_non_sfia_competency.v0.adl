definition
	CLUSTER[at0000.1] matches {    -- competency_base
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- competency_name
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- competency_description
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- competency_level
				value matches {
					DV_CODED_TEXT matches {*}
				}
			}
			ELEMENT[at0004] occurrences matches {0..1} matches {    -- date_asssesed
				value matches {
					DV_DATE_TIME matches {*}
				}
			}
			ELEMENT[at0005] occurrences matches {0..1} matches {    -- status
				value matches {
					DV_CODED_TEXT matches {*}
				}
			}
			ELEMENT[at0.1] occurrences matches {0..1} matches {    -- competency_code
				value matches {
					DV_IDENTIFIER matches {*}
				}
			}
			ELEMENT[at0.2] occurrences matches {0..1} matches {    -- registration_body
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0.3] occurrences matches {0..1} matches {    -- registration_id
				value matches {
					DV_IDENTIFIER matches {*}
				}
			}
			ELEMENT[at0.4] occurrences matches {0..1} matches {    -- registration_expiry
				value matches {
					DV_DATE_TIME matches {*}
				}
			}
			ELEMENT[at0.5] occurrences matches {0..1} matches {    -- clinical_years_practice
				value matches {
					DV_COUNT matches {*}
				}
			}
		}
	}

