definition
	EVALUATION[at0000] matches {    -- competency_profile
		data matches {
			ITEM_TREE[at0001] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..1} matches {    -- role_identifier
						value matches {
							DV_IDENTIFIER matches {*}
						}
					}
					ELEMENT[at0003] occurrences matches {0..1} matches {    -- role_name
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0005] occurrences matches {0..1} matches {    -- role_type
						value matches {
							DV_IDENTIFIER matches {*}
						}
					}
					ELEMENT[at0006] occurrences matches {0..1} matches {    -- role_type
						value matches {
							DV_ORDINAL matches {*}
						}
					}
					ELEMENT[at0007] occurrences matches {0..1} matches {    -- role_version
						value matches {
							DV_TEXT matches {*}
						}
					}
					allow_archetype CLUSTER[at0008] occurrences matches {0..*} matches {    -- sfia_ict_competencies
						include
							archetype_id/value matches {/openEHR-EHR-CLUSTER\.sfia_competency-sfia_ict_competency\.v0/}
					}
					allow_archetype CLUSTER[at0009] occurrences matches {0..*} matches {    -- sfia_dh_competencies
						include
							archetype_id/value matches {/openEHR-EHR-CLUSTER\.sfia_competency-sfia_dh_competency\.v0/}
					}
					allow_archetype CLUSTER[at0010] occurrences matches {0..*} matches {    -- clinical_non_sfia_cometencies
						include
							archetype_id/value matches {/openEHR-EHR-CLUSTER\.clinical_non_sfia_competency\.v0/}
					}
					allow_archetype CLUSTER[at0011] occurrences matches {0..*} matches {    -- other_non_sfia_competencies
						include
							archetype_id/value matches {/openEHR-EHR-CLUSTER\.other_non_sfia_competency\.v0/}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0012] matches {*}    -- Item tree
		}
	}

