definition
	CLUSTER[at0000] matches {    -- organisation_group
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- group_id
				value matches {
					DV_IDENTIFIER matches {*}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- group_name
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- group_type
				value matches {
					DV_CODED_TEXT matches {*}
				}
			}
			allow_archetype CLUSTER[at0004] occurrences matches {0..*} matches {    -- member_orgnisations
				include
					archetype_id/value matches {/openEHR-EHR-CLUSTER\.organisation\.v1/}
			}
			ELEMENT[at0007] occurrences matches {0..1} matches {    -- group_coordinator
				value matches {
					DV_IDENTIFIER matches {*}
				}
			}
			ELEMENT[at0008] occurrences matches {0..1} matches {    -- description
				value matches {
					DV_TEXT matches {*}
				}
			}
		}
	}

