definition
	ADMIN_ENTRY[at0000] matches {    -- role_profile
		data matches {
			ITEM_TREE[at0001] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					allow_archetype CLUSTER[at0002] occurrences matches {0..1} matches {    -- org_context
						include
							archetype_id/value matches {/openEHR-EHR-CLUSTER\.organisation_context\.v0/}
					}
					ELEMENT[at0003] occurrences matches {0..1} matches {    -- role_id
						value matches {
							DV_IDENTIFIER matches {*}
						}
					}
					ELEMENT[at0004] occurrences matches {0..1} matches {    -- organisation_ref
						value matches {
							DV_IDENTIFIER matches {*}
						}
					}
					ELEMENT[at0005] occurrences matches {0..1} matches {    -- role_type
						value matches {
							DV_CODED_TEXT matches {*}
						}
					}
					ELEMENT[at0006] occurrences matches {0..1} matches {    -- primary_domain
						value matches {
							DV_CODED_TEXT matches {*}
						}
					}
					ELEMENT[at0007] occurrences matches {0..1} matches {    -- role_name
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0008] occurrences matches {0..1} matches {    -- start
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					ELEMENT[at0009] occurrences matches {0..1} matches {    -- end
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					ELEMENT[at0010] occurrences matches {0..1} matches {    -- competency_profile_ref
						value matches {
							DV_EHR_URI matches {*}
						}
					}
					ELEMENT[at0011] matches {    -- person_ehr_ref
						value matches {
							DV_EHR_URI matches {*}
						}
					}
					ELEMENT[at0012] matches {    -- universal_role_ref
						value matches {
							DV_IDENTIFIER matches {*}
						}
					}
				}
			}
		}
	}

