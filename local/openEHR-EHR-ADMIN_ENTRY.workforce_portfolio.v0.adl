definition
	ADMIN_ENTRY[at0000] matches {    -- workforce_portfolio
		data matches {
			ITEM_TREE[at0001] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] matches {    -- portfolio_name
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0003] matches {    -- time_commited
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					ELEMENT[at0004] occurrences matches {0..*} matches {    -- ecosystem_refs
						value matches {
							DV_EHR_URI matches {*}
						}
					}
					ELEMENT[at0005] occurrences matches {0..*} matches {    -- role_profile_refs
						value matches {
							DV_EHR_URI matches {*}
						}
					}
					ELEMENT[at0006] occurrences matches {0..1} matches {    -- person_competency_record_ref
						value matches {
							DV_EHR_URI matches {*}
						}
					}
					ELEMENT[at0009] occurrences matches {0..*} matches {    -- pathway_enrollment_refs
						value matches {
							DV_EHR_URI matches {*}
						}
					}
					ELEMENT[at0010] occurrences matches {0..*} matches {    -- career_pathway_refs
						value matches {
							DV_EHR_URI matches {*}
						}
					}
				}
			}
		}
	}

