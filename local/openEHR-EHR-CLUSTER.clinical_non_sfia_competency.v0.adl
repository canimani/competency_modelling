				value matches {
					DV_IDENTIFIER matches {*}
				}
			}
			ELEMENT[at0004] occurrences matches {0..1} matches {    -- registration_expiry
				value matches {
					DV_DATE matches {*}
				}
			}
			ELEMENT[at0005] occurrences matches {0..1} matches {    -- clinical_years_practice
				value matches {
					DV_COUNT matches {*}
				}
			}
		}
	}

