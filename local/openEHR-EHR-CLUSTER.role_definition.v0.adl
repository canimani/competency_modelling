definition
	CLUSTER[at0000] matches {    -- role_definition
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- role_definition_id
				value matches {
					DV_IDENTIFIER matches {*}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- cannonical_title
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- role_type
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0004,    -- Simple
							at0005]    -- Composite
						}
					}
				}
			}
			ELEMENT[at0006] occurrences matches {0..1} matches {    -- typical_duration_months
				value matches {
					DV_COUNT matches {*}
				}
			}
			ELEMENT[at0007] occurrences matches {0..1} matches {    -- description
				value matches {
					DV_TEXT matches {*}
				}
			}
			allow_archetype CLUSTER[at0008] occurrences matches {0..*} matches {    -- occupational_classification
				include
					archetype_id/value matches {/openEHR-EHR-CLUSTER\.occupational_classification\.v0/}
			}
			allow_archetype CLUSTER[at0009] occurrences matches {0..*} matches {    -- disciplinary_classification
				include
					archetype_id/value matches {/openEHR-EHR-CLUSTER\.disciplinary_classification\.v0/}
			}
			allow_archetype CLUSTER[at0010] occurrences matches {0..*} matches {    -- generic_skills_classification
				include
					archetype_id/value matches {/openEHR-EHR-CLUSTER\.generic_skills_classification\.v0/}
			}
			allow_archetype CLUSTER[at0011] occurrences matches {0..*} matches {    -- digital_health_skills_classification
				include
					archetype_id/value matches {/openEHR-EHR-CLUSTER\.digital_health_skills_classification\.v0/}
			}
			allow_archetype CLUSTER[at0012] occurrences matches {0..*} matches {    -- organisation_role_mappings
				include
					archetype_id/value matches {/openEHR-EHR-CLUSTER\.organisation_role_mapping\.v0/}
			}
		}
	}

