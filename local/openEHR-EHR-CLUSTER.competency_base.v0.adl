definition
	CLUSTER[at0000] matches {    -- competency_base
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0008] occurrences matches {0..1} matches {    -- skill
				value matches {
					DV_CODED_TEXT matches {*}
				}
			}
			ELEMENT[at0011] occurrences matches {0..1} matches {    -- terminology
				value matches {
					DV_CODED_TEXT matches {*}
				}
				name matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0012,    -- SFIA v9
							at0013]    -- GMC Standards
						}
					}
				}
			}
			ELEMENT[at0014] occurrences matches {0..1} matches {    -- terminology_version
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0015] occurrences matches {0..1} matches {    -- method
				value matches {
					DV_CODED_TEXT matches {*}
				}
				name matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0016,    -- self-assessment
							at0017,    -- peer-review
							at0018,    -- panel
							at0019]    -- examination
						}
					}
				}
			}
			ELEMENT[at0004] occurrences matches {0..1} matches {    -- assessed_on
				value matches {
					DV_DATE_TIME matches {*}
				}
			}
			ELEMENT[at0005] occurrences matches {0..1} matches {    -- status
				value matches {
					DV_CODED_TEXT matches {*}
				}
			}
		}
	}

