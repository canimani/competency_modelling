definition
	ADMIN_ENTRY[at0000] matches {    -- ecosystem_role_definition
		data matches {
			ITEM_TREE[at0001] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] matches {    -- ecosystem_role_id
						value matches {
							DV_IDENTIFIER matches {*}
						}
					}
					ELEMENT[at0003] matches {    -- universal_role_ref
						value matches {
							DV_IDENTIFIER matches {*}
						}
					}
					ELEMENT[at0004] matches {    -- ecosystem_ref
						value matches {
							DV_IDENTIFIER matches {*}
						}
					}
					ELEMENT[at0005] occurrences matches {0..1} matches {    -- local_title
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0006] occurrences matches {0..1} matches {    -- min_level_override
						value matches {
							DV_ORDINAL matches {*}
						}
						name matches {
							DV_CODED_TEXT matches {*}
						}
					}
					allow_archetype CLUSTER[at0007] occurrences matches {0..*} matches {    -- addtional_competency_requirements
						include
							archetype_id/value matches {/openEHR-EHR-CLUSTER\.competency_base\.v0/}
					}
					allow_archetype CLUSTER[at0008] occurrences matches {0..*} matches {    -- organisation_role_mapping
						include
							archetype_id/value matches {/.*/}
					}
					ELEMENT[at0009] matches {    -- valide_from
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					ELEMENT[at0010] occurrences matches {0..1} matches {    -- valid_to
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					ELEMENT[at0011] matches {    -- rational
						value matches {
							DV_TEXT matches {*}
						}
					}
				}
			}
		}
	}

