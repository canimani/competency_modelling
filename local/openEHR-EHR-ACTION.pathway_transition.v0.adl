definition
	ACTION[at0000] matches {    -- pathway_transition
		description matches {
			ITEM_TREE[at0001] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0003] matches {    -- enrollment_ref
						value matches {
							DV_IDENTIFIER matches {*}
						}
					}
					ELEMENT[at0004] matches {    -- from_step_order
						value matches {
							DV_PROPORTION matches {*}
						}
					}
					ELEMENT[at0005] matches {    -- to_step_order
						value matches {
							DV_COUNT matches {*}
						}
					}
					ELEMENT[at0006] matches {    -- transition_type
						value matches {
							DV_CODED_TEXT matches {*}
						}
					}
					ELEMENT[at0007] occurrences matches {0..1} matches {    -- matched_rule_ref
						value matches {
							DV_IDENTIFIER matches {*}
						}
					}
					ELEMENT[at0008] occurrences matches {0..1} matches {    -- from_role_ref
						value matches {
							DV_IDENTIFIER matches {*}
						}
					}
					ELEMENT[at0009] occurrences matches {0..1} matches {    -- to_role_ref
						value matches {
							DV_IDENTIFIER matches {*}
						}
					}
					ELEMENT[at0010] matches {    -- proposed_date
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					ELEMENT[at0011] matches {    -- gate_condition_met
						value matches {
							DV_BOOLEAN matches {*}
						}
					}
					ELEMENT[at0012] occurrences matches {0..1} matches {    -- gate_check_date
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					ELEMENT[at0013] occurrences matches {0..1} matches {    -- gate_failure_reason
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0014] occurrences matches {0..1} matches {    -- enacted_date
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					ELEMENT[at0015] occurrences matches {0..1} matches {    -- approver_ref
						value matches {
							DV_EHR_URI matches {*}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0002] matches {*}    -- Item tree
		}
	}

