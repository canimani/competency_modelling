definition
	CLUSTER[at0000] matches {    -- organisation_role_mapping
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- local_role_mapping
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- organisation_ref
				value matches {
					DV_IDENTIFIER matches {*}
				}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- jurisdiction
				value matches {
					DV_CODED_TEXT matches {*}
				}
			}
			ELEMENT[at0004] occurrences matches {0..1} matches {    -- layer1_occupational_code
				value matches {
					DV_IDENTIFIER matches {*}
				}
			}
			ELEMENT[at0005] occurrences matches {0..1} matches {    -- Layer2_disciplinary_code
				value matches {
					DV_IDENTIFIER matches {*}
				}
			}
			ELEMENT[at0006] occurrences matches {0..1} matches {    -- layer3_generic_skills_code
				value matches {
					DV_IDENTIFIER matches {*}
				}
			}
			ELEMENT[at0009] occurrences matches {0..1} matches {    -- layer4_digital_health_skills_code
				value matches {
					DV_IDENTIFIER matches {*}
				}
			}
			ELEMENT[at0010] occurrences matches {0..1} matches {    -- equivalence_rationale
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0011] occurrences matches {0..1} matches {    -- valid_from
				value matches {
					DV_DATE_TIME matches {*}
				}
			}
		}
	}

