definition
	CLUSTER[at0000] matches {    -- required_skill_conditions
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] matches {    -- skill_code
				value matches {
					DV_IDENTIFIER matches {*}
				}
			}
			ELEMENT[at0002] matches {    -- skill_name
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0003] matches {    -- skill_group
				value matches {
					DV_CODED_TEXT matches {*}
				}
				name matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0004,    -- sfia_ict_competency
							at0005]    -- sfia_dh_competency
						}
					}
				}
			}
			ELEMENT[at0006] matches {    -- min_lvel
				value matches {
					DV_ORDINAL matches {*}
				}
			}
			ELEMENT[at0008] occurrences matches {0..1} matches {    -- manadatory_or_desirable
				value matches {
					DV_CODED_TEXT matches {*}
				}
				name matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0009,    -- mandatory
							at0010]    -- desirable
						}
					}
				}
			}
			ELEMENT[at0011] occurrences matches {0..1} matches {    -- required_evidence
				value matches {
					DV_BOOLEAN matches {*}
				}
			}
		}
	}

