definition
	CLUSTER[at0000] matches {    -- digital_health_skills_classification
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- classification_scheme
				value matches {
					DV_CODED_TEXT matches {*}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- skill_code
				value matches {
					DV_IDENTIFIER matches {*}
				}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- skill_title
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0004] occurrences matches {0..1} matches {    -- scheme_version
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0005] occurrences matches {0..1} matches {    -- expected_level
				value matches {
					DV_ORDINAL matches {*}
				}
			}
			ELEMENT[at0006] occurrences matches {0..1} matches {    -- mandatory_or_desirable
				value matches {
					DV_CODED_TEXT matches {*}
				}
			}
		}
	}

