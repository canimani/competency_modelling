definition
	CLUSTER[at0000] matches {    -- competency_delta
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0002] matches {    -- delta_type
				value matches {
					DV_CODED_TEXT matches {*}
				}
				name matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0003,    -- level_increment
							at0004,    -- new_skill_acquisition
							at0005,    -- skill_removal
							at0006]    -- new_cluster_type
						}
					}
				}
			}
			ELEMENT[at0008] matches {    -- skill_code_ref
				value matches {
					DV_IDENTIFIER matches {*}
				}
			}
			ELEMENT[at0009] matches {    -- skill_name_ref
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0010] matches {    -- from_level
				value matches {
					DV_ORDINAL matches {*}
				}
			}
			ELEMENT[at0011] matches {    -- to_level
				value matches {
					DV_ORDINAL matches {*}
				}
			}
			ELEMENT[at0012] matches {    -- new_cluster_type
				value matches {
					DV_CODED_TEXT matches {*}
				}
			}
			ELEMENT[at0013] occurrences matches {0..1} matches {    -- rationale
				value matches {
					DV_TEXT matches {*}
				}
			}
		}
	}

