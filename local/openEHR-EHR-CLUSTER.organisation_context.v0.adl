definition
	CLUSTER[at0000] matches {    -- organisation_context
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] matches {    -- ecosystem_maturity
				value matches {
					0|[local::at0002],
					1|[local::at0003],
					2|[local::at0004]
				}
			}
			ELEMENT[at0005] matches {    -- organisation_maturity
				value matches {
					0|[local::at0006],
					1|[local::at0007],
					2|[local::at0008],
					3|[local::at0009]
				}
			}
			ELEMENT[at0010] matches {    -- organisation_size
				value matches {
					1|[local::at0011],
					2|[local::at0012],
					3|[local::at0013]
				}
			}
		}
	}

