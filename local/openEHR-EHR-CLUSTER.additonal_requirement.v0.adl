definition
	CLUSTER[at0000] matches {    -- additonal_requirement
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] matches {    -- requirement_type
				value matches {
					DV_COUNT matches {*}
				}
				name matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0007,    -- qualification
							at0008,    -- registration
							at0009,    -- external_role_ref
							at0010]    -- competency_threshold
						}
					}
				}
			}
			ELEMENT[at0002] matches {    -- rational
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- ref_pathway_ref
				value matches {
					DV_IDENTIFIER matches {*}
				}
			}
			ELEMENT[at0004] occurrences matches {0..1} matches {    -- ref_role_definition_ref
				value matches {
					DV_IDENTIFIER matches {*}
				}
			}
			ELEMENT[at0005] occurrences matches {0..1} matches {    -- min_duration_month
				value matches {
					DV_COUNT matches {*}
				}
			}
			ELEMENT[at0006] occurrences matches {0..1} matches {    -- concurrent_or_prior
				value matches {
					DV_CODED_TEXT matches {*}
				}
			}
			ELEMENT[at0013] occurrences matches {0..1} matches {    -- framework
				value matches {
					DV_CODED_TEXT matches {*}
				}
				name matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0014,    -- Non-SFIA framework code
							at0015,    -- CMC Standard
							at0016,    -- GPhC
							at0017]    -- RCN
						}
					}
				}
			}
			ELEMENT[at0018] occurrences matches {0..1} matches {    -- competency_code
				value matches {
					DV_CODED_TEXT matches {*}
				}
				name matches {
					DV_CODED_TEXT matches {*}
				}
			}
			ELEMENT[at0019] occurrences matches {0..1} matches {    -- qualification_name
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0020] occurrences matches {0..1} matches {    -- awarding_body
				value matches {
					DV_TEXT matches {*}
				}
			}
		}
	}

