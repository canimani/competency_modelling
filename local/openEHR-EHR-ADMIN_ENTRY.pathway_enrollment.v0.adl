definition
	ADMIN_ENTRY[at0000] matches {    -- pathway_enrollment
		data matches {
			ITEM_TREE[at0001] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] matches {    -- enrollment_id
						value matches {
							DV_IDENTIFIER matches {*}
						}
					}
					ELEMENT[at0003] occurrences matches {0..1} matches {    -- pathway_ref
						value matches {
							DV_IDENTIFIER matches {*}
						}
					}
					ELEMENT[at0004] occurrences matches {0..1} matches {    -- enrollment_date
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					ELEMENT[at0005] occurrences matches {0..1} matches {    -- current_step_order
						value matches {
							DV_COUNT matches {*}
						}
					}
					ELEMENT[at0006] matches {    -- status
						value matches {
							DV_CODED_TEXT matches {*}
						}
						name matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0007,    -- active
									at0008,    -- compeleted
									at0009,    -- withdrawn
									at0010,    -- paused
									at0011]    -- exited_diagonal
								}
							}
						}
					}
					ELEMENT[at0012] occurrences matches {0..1} matches {    -- source_pathway_ref
						value matches {
							DV_IDENTIFIER matches {*}
						}
					}
					ELEMENT[at0013] occurrences matches {0..1} matches {    -- source_role_ref
						value matches {
							DV_IDENTIFIER matches {*}
						}
					}
					ELEMENT[at0014] occurrences matches {0..1} matches {    -- entry_step_order
						value matches {
							DV_COUNT matches {*}
						}
					}
					ELEMENT[at0015] matches {    -- entry_rule_matched_ref
						value matches {
							DV_IDENTIFIER matches {*}
						}
					}
				}
			}
		}
	}

