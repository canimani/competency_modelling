definition
	ADMIN_ENTRY[at0000] matches {    -- career_pathway
		data matches {
			ITEM_TREE[at0001] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..1} matches {    -- pathway_id
						value matches {
							DV_IDENTIFIER matches {*}
						}
					}
					ELEMENT[at0003] occurrences matches {0..1} matches {    -- pathway_name
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0004] occurrences matches {0..1} matches {    -- pathway_type
						value matches {
							DV_CODED_TEXT matches {*}
						}
					}
					ELEMENT[at0006] occurrences matches {0..1} matches {    -- univeral_role_definition
						value matches {
							DV_IDENTIFIER matches {*}
						}
					}
					ELEMENT[at0007] occurrences matches {0..1} matches {    -- ecosystem_role_override_ref
						value matches {
							DV_IDENTIFIER matches {*}
						}
					}
					ELEMENT[at0005] occurrences matches {0..1} matches {    -- description
						value matches {
							DV_TEXT matches {*}
						}
					}
					allow_archetype CLUSTER[at0008] occurrences matches {0..*} matches {    -- full_gate
						include
							archetype_id/value matches {/openEHR-EHR-CLUSTER\.transisiton_gate\.v0/}
					}
				}
			}
		}
	}

