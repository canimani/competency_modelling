definition
	CLUSTER[at0000.1] matches {    -- sfia_competency
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- sfia_code
				value matches {
					DV_IDENTIFIER matches {*}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- current_level
				value matches {
					DV_ORDINAL matches {*}
				}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- target_level
				value matches {
					DV_ORDINAL matches {*}
				}
			}
			ELEMENT[at0.1] occurrences matches {0..1} matches {    -- dh_domain
				value matches {
					DV_CODED_TEXT matches {*}
				}
			}
			ELEMENT[at0.2] occurrences matches {0..1} matches {    -- capability_tier
				value matches {
					DV_ORDINAL matches {*}
				}
			}
		}
	}

