definition
	EVALUATION[at0000] matches {    -- person_competency_record
		data matches {
			ITEM_TREE[at0001] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					allow_archetype CLUSTER[at0002] occurrences matches {0..*} matches {    -- sfia_ict_competencies
						include
							archetype_id/value matches {/openEHR-EHR-CLUSTER\.sfia_competency-sfia_ict_competency\.v0/}
					}
					allow_archetype CLUSTER[at0003] occurrences matches {0..*} matches {    -- sfia_dh_competencies
						include
							archetype_id/value matches {/openEHR-EHR-CLUSTER\.sfia_competency-sfia_dh_competency\.v0/}
					}
					allow_archetype CLUSTER[at0004] occurrences matches {0..*} matches {    -- clinical_competencies
						include
							archetype_id/value matches {/openEHR-EHR-CLUSTER\.clinical_non_sfia_competency\.v0/}
					}
					allow_archetype CLUSTER[at0005] occurrences matches {0..*} matches {    -- other_competencies
						include
							archetype_id/value matches {/openEHR-EHR-CLUSTER\.other_non_sfia_competency\.v0/}
					}
					ELEMENT[at0007] occurrences matches {0..1} matches {    -- record_date
						value matches {
							DV_DATE matches {*}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0006] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0012] occurrences matches {0..1} matches {    -- assessor_ref
						value matches {
							DV_IDENTIFIER matches {
								issuer matches {/HR_Ststem/}
								type matches {/PERSON or ORGANISSATION/}
								assigner matches {/PARTY_REF/}
								id matches {/external ID/}
							}
						}
					}
				}
			}
		}
		other_participations cardinality matches {0..*; unordered} matches {
			PARTICIPATION[at0008] occurrences matches {0..1} matches {    -- PARTICIPATION
				performer matches {
					PARTY_PROXY[at0013] matches {*}    -- assessor
					allow_archetype PARTY_PROXY[at0014] occurrences matches {0..*} matches {    -- PARTY_PROXY
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
	}

