definition
	CLUSTER[at0000] matches {    -- step_entry_rule
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] matches {    -- rule_id
				value matches {
					DV_IDENTIFIER matches {*}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- source_role_definition
				value matches {
					DV_IDENTIFIER matches {*}
				}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- source_pathway_ref
				value matches {
					DV_IDENTIFIER matches {*}
				}
			}
			ELEMENT[at0004] occurrences matches {0..1} matches {    -- transiiton_type
				value matches {
					DV_CODED_TEXT matches {*}
				}
				name matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0005,    -- vertical
							at0006,    -- diagonal
							at0007]    -- hybrid
						}
					}
				}
			}
			allow_archetype CLUSTER[at0008] matches {    -- competency_group_gate
				include
					archetype_id/value matches {/openEHR-EHR-CLUSTER\.competency_group_gate\.v0/}
			}
			allow_archetype CLUSTER[at0010] matches {    -- base_gate
				include
					archetype_id/value matches {/.*/}
			}
			allow_archetype CLUSTER[at0011] occurrences matches {0..*} matches {    -- CLUSTER_SLOT
			}
		}
	}

