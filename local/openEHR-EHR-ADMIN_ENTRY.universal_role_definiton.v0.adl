definition
	ADMIN_ENTRY[at0000] matches {    -- universal_role_definiton
		data matches {
			ITEM_TREE[at0001] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] matches {    -- universal_role_id
						value matches {
							DV_IDENTIFIER matches {*}
						}
					}
					ELEMENT[at0003] matches {    -- cannonical_title
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0004] occurrences matches {0..1} matches {    -- role_type
						value matches {
							DV_CODED_TEXT matches {*}
						}
					}
					ELEMENT[at0005] occurrences matches {0..1} matches {    -- issuing_authority
						value matches {
							DV_IDENTIFIER matches {*}
						}
					}
					ELEMENT[at0006] occurrences matches {0..1} matches {    -- version
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0007] occurrences matches {0..1} matches {    -- tyoical_duration_month
						value matches {
							DV_COUNT matches {*}
						}
					}
					allow_archetype CLUSTER[at0008] occurrences matches {0..*} matches {    -- occupational_classification
						include
							archetype_id/value matches {/openEHR-EHR-CLUSTER\.occupational_classification\.v0/}
					}
					allow_archetype CLUSTER[at0009] occurrences matches {0..*} matches {    -- disciplinary_classification
						include
							archetype_id/value matches {/openEHR-EHR-CLUSTER\.disciplinary_classification\.v0/}
					}
					allow_archetype CLUSTER[at0010] occurrences matches {0..*} matches {    -- generic_skills_classification
						include
							archetype_id/value matches {/openEHR-EHR-CLUSTER\.generic_skills_classification\.v0/}
					}
					allow_archetype CLUSTER[at0011] occurrences matches {0..*} matches {    -- digital_health_skills_classification
						include
							archetype_id/value matches {/openEHR-EHR-CLUSTER\.digital_health_skills_classification\.v0/}
					}
				}
			}
		}
	}

