definition
	ADMIN_ENTRY[at0000] matches {    -- universal_role_definition
		data matches {
			ITEM_TREE[at0001] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] matches {    -- universal_role_id
						value matches {
							DV_IDENTIFIER matches {*}
						}
					}
					ELEMENT[at0003] occurrences matches {0..1} matches {    -- canonical_title
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0004] matches {    -- role_type
						value matches {
							DV_CODED_TEXT matches {*}
						}
					}
					ELEMENT[at0005] matches {    -- issuing_authority
						value matches {
							DV_IDENTIFIER matches {*}
						}
					}
					ELEMENT[at0006] matches {    -- version
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0007] occurrences matches {0..1} matches {    -- typcial_duration_months
						value matches {
							DV_COUNT matches {*}
						}
					}
					allow_archetype CLUSTER[at0008] occurrences matches {0..*} matches {    -- occupational_classification
						include
							archetype_id/value matches {/openEHR-EHR-CLUSTER\.occupational_classification\.v0/}
					}
					allow_archetype CLUSTER[at0009] occurrences matches {0..*} matches {    -- disciplinary_classification
						include
							archetype_id/value matches {/openEHR-EHR-CLUSTER\.disciplinary_classification\.v0/}
					}
					allow_archetype CLUSTER[at0010] occurrences matches {0..*} matches {    -- generic_skills_classification
						include
							archetype_id/value matches {/openEHR-EHR-CLUSTER\.generic_skills_classification\.v0/}
					}
					allow_archetype CLUSTER[at0013] occurrences matches {1..*} matches {    -- digital_health_skills_classifications
						include
							archetype_id/value matches {/openEHR-EHR-CLUSTER\.digital_health_skills_classification\.v0/}
					}
					allow_archetype CLUSTER[at0011] occurrences matches {0..*} matches {    -- organisation_role_mapping
						include
							archetype_id/value matches {/openEHR-EHR-CLUSTER\.organisation_role_mapping\.v0/}
					}
					allow_archetype CLUSTER[at0012] occurrences matches {0..*} matches {    -- required_competencies
						include
							archetype_id/value matches {/openEHR-EHR-CLUSTER\.competency_base\.v0/}
					}
				}
			}
		}
	}

