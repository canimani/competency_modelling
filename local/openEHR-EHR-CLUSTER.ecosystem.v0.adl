definition
	CLUSTER[at0000] matches {    -- ecosystem
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- ecosystem_id
				value matches {
					DV_IDENTIFIER matches {*}
				}
			}
			ELEMENT[at0004] occurrences matches {0..1} matches {    -- ecosystem_name
				value matches {
					DV_TEXT matches {*}
				}
			}
			allow_archetype CLUSTER[at0005] occurrences matches {0..*} matches {    -- organisations
				include
					archetype_id/value matches {/openEHR-EHR-CLUSTER\.organisation\.v1/}
			}
			allow_archetype CLUSTER[at0006] occurrences matches {0..*} matches {    -- organisations_groups
				include
					archetype_id/value matches {/openEHR-EHR-CLUSTER\.organisation_group\.v0/}
			}
		}
	}

